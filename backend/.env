# Copiar este archivo como ".env" en la carpeta backend/ y completar
# con los datos reales de tu servidor MySQL (Workbench).
# El archivo .env NUNCA debe subirse a Git (ver .gitignore).

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=agrega_tu_contraseña_de_tu_base_de_dato
DB_NAME=liquidacion_choferes

# Clave usada para firmar la cookie de sesión. Poné cualquier texto
# largo y aleatorio, distinto en cada entorno (desarrollo/producción).
SESSION_SECRET=agrega_la_clave_de_tu_session_secreta

PORT=3000
